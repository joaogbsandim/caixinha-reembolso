# Copie este arquivo para .env e preencha os valores
# NÃO commite o .env no git

# PostgreSQL — Neon
# Encontre em: neon.tech > seu projeto > Connection string
DATABASE_URL=postgres://user:password@host.neon.tech/dbname?sslmode=require

# Cloudflare R2
# Encontre em: Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<seu_access_key_id>
R2_SECRET_ACCESS_KEY=<seu_secret_access_key>
R2_BUCKET_NAME=caixinha-uploads

# URL pública do bucket R2
# Ative em: R2 > seu bucket > Settings > Public Access
R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# Porta local (opcional)
PORT=3000
